rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /papers/{paperId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "ianupama835@gmail.com";
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "ianupama835@gmail.com");
    }
  }
}
